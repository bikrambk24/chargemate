{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "station-service",
      "image": "016963913530.dkr.ecr.us-east-1.amazonaws.com/chargemate-station-service:latest",
      "essential": true,
      "memory": 256,
      "portMappings": [
        { "hostPort": 4001, "containerPort": 4001 }
      ],
      "environment": [
        { "name": "PORT", "value": "4001" },
        { "name": "NODE_ENV", "value": "production" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/chargemate/station-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "station"
        }
      }
    },
    {
      "name": "booking-service",
      "image": "016963913530.dkr.ecr.us-east-1.amazonaws.com/chargemate-booking-service:latest",
      "essential": true,
      "memory": 256,
      "portMappings": [
        { "hostPort": 4002, "containerPort": 4002 }
      ],
      "links": ["station-service"],
      "environment": [
        { "name": "PORT", "value": "4002" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "STATION_SERVICE_URL", "value": "http://station-service:4001" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/chargemate/booking-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "booking"
        }
      }
    },
    {
      "name": "frontend",
      "image": "016963913530.dkr.ecr.us-east-1.amazonaws.com/chargemate-frontend:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        { "hostPort": 80, "containerPort": 3000 }
      ],
      "links": ["station-service", "booking-service"],
      "environment": [
        { "name": "NODE_ENV", "value": "production" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/chargemate/frontend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}