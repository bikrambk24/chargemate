{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/station-service.log",
            "log_group_name": "/chargemate/station-service",
            "log_stream_name": "{instance_id}/station-service",
            "timezone": "UTC",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/booking-service.log",
            "log_group_name": "/chargemate/booking-service",
            "log_stream_name": "{instance_id}/booking-service",
            "timezone": "UTC",
            "retention_in_days": 30
          },
          {
            "file_path": "/var/log/frontend.log",
            "log_group_name": "/chargemate/frontend",
            "log_stream_name": "{instance_id}/frontend",
            "timezone": "UTC",
            "retention_in_days": 30
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "ChargeMate",
    "metrics_collected": {
      "cpu": {
        "resources": ["*"],
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": 60
      },
      "mem": {
        "measurement": [
          "mem_used",
          "mem_used_percent",
          "mem_available_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "resources": ["/"],
        "measurement": [
          "disk_used_percent",
          "disk_free"
        ],
        "metrics_collection_interval": 300
      },
      "net": {
        "resources": ["eth0"],
        "measurement": [
          "bytes_recv",
          "bytes_sent"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
