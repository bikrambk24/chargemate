{ 
 "name": "booking-service", 
 "version": "1.0.0", 
 "description": "ChargeMate Booking Service", 
 "main": "src/app.js", 
 "scripts": { 
   "start": "node src/app.js", 
   "dev": "nodemon src/app.js", 
   "test": "jest --coverage --forceExit", 
   "test:ci": "jest --coverage --forceExit --ci", 
   "lint": "eslint src/ --ext .js", 
   "lint:fix": "eslint src/ --ext .js --fix" 
 }, 
 "dependencies": { 
   "axios": "^1.6.2", 
   "cors": "^2.8.5", 
   "dotenv": "^16.3.1", 
   "express": "^4.18.2", 
   "jsonwebtoken": "^9.0.2", 
   "mongoose": "^7.6.3", 
   "morgan": "^1.10.0" 
 }, 
 "devDependencies": { 
   "eslint": "^8.55.0", 
   "jest": "^29.7.0", 
   "nodemon": "^3.0.1", 
   "supertest": "^6.3.3" 
 }, 
 "jest": { 
   "testEnvironment": "node", 
   "coverageDirectory": "coverage", 
   "collectCoverageFrom": [ 
     "src/**/*.js", 
     "!src/server.js" 
   ], 
   "coverageReporters": [ 
     "text", 
     "lcov", 
     "html" 
   ], 
   "testTimeout": 30000, 
   "forceExit": true 
 } 
}
